# Copy to .env.local and fill in. Never commit .env.local.
# Keys can also be pasted in Settings instead; those go to .walkmycode/keys.env and win over this file.

# Model: the provider and model used when nothing is saved in Settings (.walkmycode/config.json wins).
# The old LANTERN_* names still work when the WALKMYCODE_* ones are not set.
# WALKMYCODE_PROVIDER is one of anthropic | openai | gemini | groq | deepseek | xai | local (default anthropic)
WALKMYCODE_PROVIDER=anthropic
# Optional: the provider's model id; blank means that provider's default (claude-opus-5-5 for
# Anthropic; claude-sonnet-5-5 costs about half)
WALKMYCODE_MODEL=
# Optional: low | medium | high (default medium). Thinking or reasoning effort where the model has one.
WALKMYCODE_EFFORT=medium

# One key per provider; only the one you use is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# DeepSeek's servers are in China and its terms allow training on inputs.
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Local models (Ollama or LM Studio): no key needed.
# Optional: the server's address (default http://localhost:11434/v1; LM Studio is http://localhost:1234/v1)
LOCAL_BASE_URL=
# Optional: a bearer token, for LM Studio when it has one set
LOCAL_API_KEY=

# Optional: 1 lets other machines on your network use this WalkMyCode (and spend your keys). Leave unset.
WALKMYCODE_ALLOW_REMOTE=

# Voice (Settings → Voice, docs/VOICE.md). ElevenLabs reads tours and answers aloud and runs the
# default lecturer (Talk); Deepgram is the other narrator and the cheaper lecturer. Without either
# key, your browser's own voice reads aloud and Talk is off.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
